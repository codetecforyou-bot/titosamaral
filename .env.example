# ─────────────────────────────────────────────────────────────
# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://titosamaral.adv.br

# ─────────────────────────────────────────────────────────────
# Banco de dados dos contatos (Supabase)
# Crie o projeto em https://supabase.com, rode supabase/schema.sql
# no SQL Editor e copie as chaves em Project Settings > API.
# A service role key é SECRETA: só é usada no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Painel administrativo (/admin)
# Gere o hash da senha com:  npm run hash-password -- "sua-senha"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Segredo para assinar a sessão (mínimo 32 caracteres aleatórios).
# Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ─────────────────────────────────────────────────────────────
# Aviso por e-mail a cada novo contato (opcional, via Resend)
# https://resend.com  > API Keys. O domínio do remetente precisa estar verificado.
RESEND_API_KEY=
LEADS_NOTIFY_EMAIL=
LEADS_FROM_EMAIL=Site Tito S Amaral <site@titosamaral.adv.br>

# ─────────────────────────────────────────────────────────────
# Envio para CRM / automação (opcional)
# Cada novo contato é enviado via POST (JSON) para esta URL.
# Funciona com RD Station, HubSpot (via Zapier/Make), n8n, etc.
LEADS_WEBHOOK_URL=
# Segredo opcional enviado no cabeçalho X-Webhook-Secret
LEADS_WEBHOOK_SECRET=
